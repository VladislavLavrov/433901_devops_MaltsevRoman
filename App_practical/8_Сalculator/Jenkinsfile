
pipeline {
    agent any

    stages {

        stage('Получение исходного кода') {
            steps {
                checkout scm
            }
        }

        stage('Сборка Docker-образа') {
            steps {
                dir('App_practical/8_Сalculator') {
                    sh 'docker compose build'
                }
            }
        }

        stage('Запуск приложения') {
            steps {
                dir('App_practical/8_Сalculator') {
                    sh 'docker compose up -d'
                }
            }
        }
    }

    post {
        success {
            echo 'Сборка приложения 8_Calculator успешно завершена!'
        }

        failure {
            echo 'При сборке приложения произошла ошибка!'
        }
    }
}
